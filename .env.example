# Copy to .env.local for local development (git-ignored). On Vercel, set the same names under Project Settings -> Environment Variables.

# Groq API key for the AI coach and the report. https://console.groq.com/keys
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Secret that signs session cookies and grading proofs. Any random string of 16+ characters:  openssl rand -base64 32
AUTH_SECRET=

# Database (Upstash Redis). Paste the REST URL and token from the Upstash console or the Vercel Marketplace integration.
# Leave both empty for local development: accounts and rounds are then kept in .data/store.json.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Sign in with Google (optional; the button only appears when both are set). Create an OAuth client in Google Cloud Console, see README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=   # only if the default https://<host>/api/auth/google-callback is wrong behind a proxy

# Local development only: run hidden tests in a worker thread instead of a Vercel Sandbox. Never set this in production.
GRADER=local
